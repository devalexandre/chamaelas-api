PORT=8080

# "sqlite" (default, zero setup) or "postgres"
DB_DRIVER=sqlite

# sqlite: a plain file path
DB_DSN=./data/chamaelas.db

# postgres (QA/production): uncomment and point at your instance instead
# DB_DRIVER=postgres
# DB_DSN=postgres://user:password@localhost:5432/chamaelas?sslmode=disable
